      "extract_B4_embedding_with_exact_A1_7_pinned_contract",
      "predict_success_with_FINAL_SUCCESS_B2",
      "predict_looping_with_FINAL_LOOPING_B2",
      "predict_side_effect_with_FINAL_SIDE_EFFECT_B4",
      "freeze_blind_prediction_bytes_and_sha256",
      "commit_blind_predictions",
      "confirm_git_clean"
    ],
    "prior_provenance_only": {
      "trajectory_count": 1106,
      "prediction_row_count": 3318,
      "must_be_confirmed_from_identifier_only_manifest_in_A1_10a": true,
      "mismatch_action": "STOP"
    },
    "label_access_before_blind_prediction_commit": 0
  },
  "a1_10b_one_time_label_unlock": {
    "preconditions": ["blind_prediction_artifact_committed", "blind_prediction_sha256_frozen", "git_clean"],
    "first_allowed_access": ["test_labels", "test_eligibility"],
    "allowed_operations": ["join_by_trajectory_key", "filter_by_frozen_target_eligibility", "score_frozen_predictions", "run_preregistered_bootstrap", "write_one_time_report"],
