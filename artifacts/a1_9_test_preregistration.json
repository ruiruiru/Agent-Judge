  "grading": {
    "CONFIRMED_HELDOUT_SIGNAL": "pooled_ap_lift_point_gt_0_and_ci_lower_gt_0",
    "DIRECTIONAL_BUT_NOT_CONFIRMED": "pooled_ap_lift_point_gt_0_and_ci_includes_0",
    "NOT_CONFIRMED": "pooled_ap_lift_point_le_0",
    "side_effect": "EXPLORATORY_TEST_RESULT",
    "descriptive_metrics_do_not_change_grade": true
  },
  "interpretation_scope": {
    "allowed": "held_out_official_tasks_and_trajectories",
