  "bootstrap": {
    "n_draws": 10000,
    "seed": 2027,
    "rng": "numpy.random.Generator(numpy.random.PCG64(2027))",
    "interval": "percentile_95",
    "resampling_unit": ["benchmark_original", "normalized_task_id"],
    "strata": "benchmark_group_primary",
    "cluster_all_model_trajectories_together": true,
    "label_stratification": false,
    "trajectory_bootstrap": false,
    "invalid_redraw": false,
